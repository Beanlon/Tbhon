# Copy to .env. Restart Expo after changes: npx expo start -c
#
# Remote URLs: from repo root run  npm run tunnel  (prints + writes .env lines)
# For Expo Go from another network/mobile data (recommended — ngrok tunnel often fails):
#   npm run mobile:start:remote
# or from this folder:
#   npm run start:remote
# Legacy (ngrok, often broken):
#   npm run mobile:start:tunnel
#   npm run start:tunnel
#
# Same Wi-Fi as host PC:
#   EXPO_PUBLIC_API_URL=http://YOUR_PC_IP:4000
#   EXPO_PUBLIC_TB_API_URL=http://YOUR_PC_IP:8000
#
# Remote / teammates (host runs Cloudflare tunnels — see infra/cloudflare/team-urls.env):
#   EXPO_PUBLIC_API_URL=https://....trycloudflare.com
#   EXPO_PUBLIC_TB_API_URL=https://....trycloudflare.com

EXPO_PUBLIC_API_URL=http://YOUR_PC_IP:4000
EXPO_PUBLIC_TB_API_URL=http://YOUR_PC_IP:8000

# Optional — required for POST /iot/hello and device-command tests on hardware setup screen
# EXPO_PUBLIC_IOT_API_KEY=your-iot-api-key
