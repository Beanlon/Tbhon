# Copy to mobile/.env. Restart Expo after changes: npx expo start -c
#
# --- iOS / cellular (HTTPS required) ---
# After droplet reboot or tunnel restart, refresh URLs automatically:
#   npm run tunnel:sync          # SSH droplet journalctl -> mobile/.env (keeps IOT key)
#   npm run tunnel:droplets      # local cloudflared proxy -> droplet IPs + auto .env
#   npm run tunnel:refresh       # re-read local tunnel logs if tunnels already running
#
# Manual fallback (see Tbhon-Backend/docs/08-cloudflare-tunnels.md):
#   journalctl -u tbhon-backend-tunnel ... | grep trycloudflare
#
# --- Same Wi-Fi only (direct HTTP, no tunnel script) ---
#   EXPO_PUBLIC_API_URL=http://159.223.42.179:4000
#   EXPO_PUBLIC_TB_API_URL=http://152.42.170.30:8000
#
# --- Local backend on this PC (not droplets) ---
#   npm run tunnel

# Optional — required for POST /iot/hello and device-command tests on hardware setup screen
# EXPO_PUBLIC_IOT_API_KEY=your-iot-api-key

# Skip Expo dependency version check when api.expo.dev is unreachable (fixes "TypeError: fetch failed" on npm start)
EXPO_NO_DEPENDENCY_VALIDATION=1
