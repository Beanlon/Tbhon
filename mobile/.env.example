# Copy to mobile/.env. Restart Expo after changes: npx expo start -c
#
# Backend runs on the DROPLET only — use droplet tunnels (not localhost :4000):
#   From repo root:  npm run tunnel:droplets
#   Writes fresh EXPO_PUBLIC_* URLs to mobile/.env via Cloudflare -> droplet IPs.
#
# Same Wi-Fi LAN fallback (direct to droplet, no tunnel script):
#   EXPO_PUBLIC_API_URL=http://159.223.42.179:4000
#   EXPO_PUBLIC_TB_API_URL=http://152.42.170.30:8000
#
# Local backend tunnels (only if you run Tbhon-Backend on this PC):
#   npm run tunnel

# Optional — required for POST /iot/hello and device-command tests on hardware setup screen
# EXPO_PUBLIC_IOT_API_KEY=your-iot-api-key
